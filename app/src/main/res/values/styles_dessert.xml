<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ThemeOverlay.Dessert.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Dessert.BottomSheet</item>
    </style>
    <style name="Widget.Dessert.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/cream</item>
    </style>

    <!-- 텍스트 -->
    <style name="Dessert.Text.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="Dessert.Text.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Dessert.Text.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Dessert.Text.Small" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/ink_sub</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Dessert.Text.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Dessert.Text.Caption" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/rose</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- 버튼 -->
    <style name="Widget.Dessert.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>
    <style name="Widget.Dessert.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/rose</item>
        <item name="android:textColor">@color/rose</item>
    </style>
    <style name="Widget.Dessert.Button.Neutral" parent="Widget.Dessert.Button.Outline">
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/ink_sub</item>
        <item name="backgroundTint">@color/white</item>
    </style>

    <!-- 칩 -->
    <style name="Widget.Dessert.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">12sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="rippleColor">@color/blush</item>
    </style>

    <!-- 입력창 -->
    <style name="Widget.Dessert.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="hintTextColor">@color/rose</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="errorTextColor">@color/rose</item>
        <item name="errorIconTint">@color/rose</item>
        <item name="boxStrokeErrorColor">@color/rose</item>
    </style>

    <!-- 선택 필드(탭하면 시트/메뉴가 열리는 읽기 전용 입력창) -->
    <style name="Widget.Dessert.SelectField" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_photo_tile</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_sub</item>
        <item name="android:drawableEnd">@drawable/ic_keyboard_arrow_down</item>
        <item name="android:drawableTint">@color/ink_sub</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    

    <!-- 등록 화면 옵션 카드 -->
    <style name="OptionCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_round_16</item>
        <item name="android:backgroundTint">@color/blush</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="OptionIcon" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_round_12</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">@color/rose</item>
    </style>
    <style name="OptionTextBox" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="FieldLabel" parent="Dessert.Text.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
