<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F1"
    tools:context=".ui.community.PostDetailActivity">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#302B27"
            android:textSize="30sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="게시판"
            android:textColor="#302B27"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⋯"
            android:textColor="#302B27"
            android:textSize="24sp" />

    </LinearLayout>

    <!-- 게시글 및 댓글 영역 -->
    <ScrollView
        android:id="@+id/scroll_post_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintBottom_toTopOf="@id/layout_comment_input">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">
            <!-- 게시글 내용이 들어갈 영역 -->

            <!-- 작성자 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <!-- 프로필 이미지 -->
                <ImageView
                    android:id="@+id/iv_author_profile"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:scaleType="centerCrop"
                    android:background="#F0E8DF"
                    android:padding="8dp"
                    android:contentDescription="작성자 프로필 이미지" />

                <!-- 닉네임 및 작성 날짜 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tv_author_nickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="다은"
                        android:textColor="#302B27"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_post_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="2026.11.18"
                        android:textColor="#99918A"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- 게시글 내용 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <!-- 게시글 제목 -->
                <TextView
                    android:id="@+id/tv_post_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="소금빵 맛있는 집 추천해주세요!"
                    android:textColor="#302B27"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- 게시글 본문 -->
                <TextView
                    android:id="@+id/tv_post_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="연남동 근처에서 소금빵 잘하는 카페 아시는 분 계신가요? 버터향이 진한 곳으로 추천 부탁드려요. 많이 달지 않아서 라테랑 정말 잘 어울렸어요. 햇살 드는 창가에서 천천히 즐기기 좋은 오후였어요."
                    android:textColor="#514A43"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>

            <!-- 게시글 사진 -->
            <ImageView
                android:id="@+id/iv_post_image"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="#F0E8DF"
                android:scaleType="centerInside"
                android:contentDescription="게시글 사진" />

            <!-- 좋아요 및 댓글 수 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/iv_like"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_heart"
                    android:contentDescription="좋아요" />

                <TextView
                    android:id="@+id/tv_like_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="12"
                    android:textColor="#302B27"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/iv_comment_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="28dp"
                    android:src="@drawable/ic_comment"
                    android:contentDescription="댓글" />

                <TextView
                    android:id="@+id/tv_comment_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="3"
                    android:textColor="#302B27"
                    android:textSize="16sp" />

            </LinearLayout>
            <!-- 댓글 목록 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp">

                <!-- 댓글 제목 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="댓글 2개"
                    android:textColor="#302B27"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- 첫 번째 댓글 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:background="#F0E8DF"
                        android:padding="7dp"
                        android:contentDescription="댓글 작성자 프로필" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <!-- 닉네임 + 작성 시간 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="소은"
                                android:textColor="#302B27"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="5분 전"
                                android:textColor="#99918A"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- 댓글 내용 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="사진만 봐도 폭신해 보여 🍓 다음엔 나랑 창가 자리 찜!"
                            android:textColor="#514A43"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <!-- 답글 달기 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="답글 달기"
                            android:textColor="#99918A"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 두 번째 댓글 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:background="#F0E8DF"
                        android:padding="7dp"
                        android:contentDescription="댓글 작성자 프로필" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <!-- 닉네임 + 작성 시간 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="버터산책"
                                android:textColor="#302B27"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="35분 전"
                                android:textColor="#99918A"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- 댓글 내용 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="크림 가벼운 케이크 찾고 있었는데! 주말에 가봐야겠어요."
                            android:textColor="#514A43"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <!-- 답글 달기 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="답글 달기"
                            android:textColor="#99918A"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 하단 댓글 입력 영역 -->
    <LinearLayout
        android:id="@+id/layout_comment_input"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:background="#FAF7F1"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/et_comment"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_comment_input"
            android:hint="댓글을 입력하세요"
            android:paddingHorizontal="14dp"
            android:textSize="12sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_comment_submit"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="↑"
            android:textColor="#D94F55"
            android:textSize="22sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
