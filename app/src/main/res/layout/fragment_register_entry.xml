<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include android:id="@+id/topBar" layout="@layout/include_top_bar" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp">

            <TextView style="@style/Dessert.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="MY DESSERT ARCHIVE" />
            <TextView style="@style/Dessert.Text.Headline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="오늘의 디저트를\n스티커로 간직해요" />
            <TextView style="@style/Dessert.Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="사진 한 장이면, 나만의 도감이 시작돼요." />

            <FrameLayout android:layout_width="match_parent" android:layout_height="200dp"
                android:layout_marginTop="20dp" android:background="@drawable/bg_round_16" android:backgroundTint="@color/cream_dark">
                <TextView style="@style/Dessert.Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="12dp"
                    android:text="나의 달콤한 순간, 한 장의 스티커" android:textSize="10sp" />
            </FrameLayout>

            <LinearLayout android:id="@+id/optionCamera" style="@style/OptionCard" android:layout_marginTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
                <ImageView style="@style/OptionIcon" android:src="@drawable/ic_photo_camera"
    android:layout_width="40dp"
    android:layout_height="40dp" />
                <LinearLayout style="@style/OptionTextBox"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
                    <TextView style="@style/Dessert.Text.Title" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="디저트 사진 찍기" />
                    <TextView style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="지금 눈앞의 디저트를 담아보세요" />
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_keyboard_arrow_down" app:tint="@color/ink_sub"
                    android:rotation="-90"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/optionGallery" style="@style/OptionCard" android:layout_marginTop="10dp"
    android:background="@drawable/bg_round_16" android:backgroundTint="@color/cream_dark"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
                <ImageView style="@style/OptionIcon" android:src="@drawable/ic_photo_library"
    android:layout_width="40dp"
    android:layout_height="40dp" />
                <LinearLayout style="@style/OptionTextBox"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
                    <TextView style="@style/Dessert.Text.Title" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="디저트 사진 올리기" />
                    <TextView style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="갤러리에서 마음에 드는 사진을 골라주세요" />
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_keyboard_arrow_down" app:tint="@color/ink_sub"
                    android:rotation="-90"/>
            </LinearLayout>

            <TextView style="@style/Dessert.Text.Small" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:layout_marginBottom="16dp" android:gravity="center"
                android:text="디저트가 선명하게 나온 사진을 골라주세요.\n배경은 지우고, 맛있는 순간만 남겨드릴게요." android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
