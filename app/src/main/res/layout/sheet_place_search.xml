<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView style="@style/Dessert.Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="장소 선택" />
    <TextView style="@style/Dessert.Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="디저트를 맛본 장소를 찾아보세요." />

    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp"
        app:endIconDrawable="@drawable/ic_cancel" app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_collect_search" app:startIconTint="@color/rose">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/queryInput"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="장소 이름으로 검색"
            android:inputType="text" android:maxLines="1" android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- TODO: 지도 SDK(네이버/카카오/구글) 확정 후 이 FrameLayout 안을 MapView 로 교체 -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="10dp"
        android:background="@color/map_bg" android:clipToOutline="true">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/mapLabel" style="@style/Dessert.Text.Caption" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:background="@drawable/bg_round_12" android:backgroundTint="@color/white" android:paddingStart="8dp"
                android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp" android:visibility="gone" />
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_place"
                app:tint="@color/rose" />
        </LinearLayout>
        <TextView android:id="@+id/mapHint" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="8dp" android:text="장소를 선택하면 지도에 표시돼요" android:textSize="10sp" />
    </FrameLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="8dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/placeList" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <ProgressBar android:id="@+id/placeProgress" android:layout_width="24dp" android:layout_height="24dp"
            android:layout_gravity="center" android:indeterminateTint="@color/rose" android:visibility="gone" />
        <TextView android:id="@+id/placeEmpty" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal" android:weightSum="2">
        <com.google.android.material.button.MaterialButton android:id="@+id/cancelButton"
            style="@style/Widget.Dessert.Button.Neutral" android:layout_width="0dp" android:layout_height="52dp"
            android:layout_marginEnd="5dp" android:layout_weight="1" android:text="취소" />
        <com.google.android.material.button.MaterialButton android:id="@+id/applyButton" android:layout_width="0dp"
            android:layout_height="52dp" android:layout_marginStart="5dp" android:layout_weight="1" android:text="적용" />
    </LinearLayout>
</LinearLayout>
