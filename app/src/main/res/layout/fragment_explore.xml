<?xml version="1.0" encoding="utf-8"?>
<!-- 탐색 탭 : 검색창, 카테고리, 지도, 카페 카드 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 탐색 화면 상단: 동네, 검색창, 카테고리 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 동네, 알림 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="#D04C54" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="연남동"
                android:id="@+id/explore_area_name"
                android:textColor="#302B27"
                android:textSize="23sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="알림"
                android:padding="8dp"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="#302B27" />
        </LinearLayout>

        <!-- 검색창 -->
        <EditText
            android:id="@+id/explore_search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_explore_pill"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:hint="지역, 카페 이름, 디저트를 검색해보세요"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:enabled="true"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#302B27"
            android:textColorHint="#8A7D73"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/explore_filter_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="64dp"
                android:backgroundTint="#F4E8DF"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="필터"
                android:textColor="#302B27"
                android:textSize="13sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#E7DFD5" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/category_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- 검색 결과 개수 -->
    <TextView
        android:id="@+id/explore_result_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="검색 결과 0개"
        android:textColor="#302B27"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 지도 뷰 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/explore_map_container"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 연관 검색어 목록 -->
        <LinearLayout
            android:id="@+id/explore_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_explore_pill"
            android:elevation="10dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/search_this_area"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="132dp"
            android:background="@drawable/bg_explore_pill"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="⟳  이 지역 다시 찾기"
            android:textColor="#302B27"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="128dp"
            android:background="@drawable/bg_explore_pill"
            android:elevation="3dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/map_zoom_in"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="지도 확대"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="+"
                android:textColor="#302B27"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/map_zoom_out"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="지도 축소"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="−"
                android:textColor="#302B27"
                android:textSize="24sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/map_my_location"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="232dp"
            android:background="@drawable/bg_explore_pill"
            android:contentDescription="내 위치로 이동"
            android:elevation="3dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="#302B27" />

        <!-- 하단 카페 카드 -->
        <LinearLayout
            android:id="@+id/explore_cafe_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:background="@drawable/bg_explore_pill"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            android:padding="8dp">

            <!-- 카페 사진 -->
            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_explore_card_photo_border">

                <ImageView
                    android:id="@+id/cafe_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_explore_card_photo_inner"
                    android:clipToOutline="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cafe_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#302B27"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cafe_menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#8A7D73"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="›"
                android:textColor="#302B27"
                android:textSize="26sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>