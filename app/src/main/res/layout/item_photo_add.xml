<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:background="@drawable/bg_photo_tile"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">
    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_photo_camera"
        app:tint="@color/ink_sub" />
    <TextView style="@style/Dessert.Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="사진 추가" android:textSize="10sp" />
</LinearLayout>
