<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">
    <ImageView android:id="@+id/thumb" android:layout_width="52dp" android:layout_height="52dp"
        android:contentDescription="앨범" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/name" style="@style/Dessert.Text.Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp" />
        <TextView android:id="@+id/count" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
