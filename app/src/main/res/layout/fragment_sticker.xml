<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <include android:id="@+id/topBar" layout="@layout/include_top_bar" />

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
                <TextView style="@style/Dessert.Text.Caption" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="MY DESSERT ARCHIVE" />
                <TextView android:id="@+id/titleText" style="@style/Dessert.Text.Headline" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/doneSub" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="나의 도감에 담을 준비가 끝났어요." android:visibility="gone" />

                <com.example.dessertrip.ui.collect.common.AspectFrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_round_16" android:backgroundTint="@color/cream_dark"
                    android:clipToOutline="true"
                    app:aspect="1.1765">
                    <ImageView android:id="@+id/previewImage" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:contentDescription="선택한 사진"
                        android:scaleType="centerCrop" />
                    <ImageView android:id="@+id/stickerImage" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:contentDescription="디저트 스티커"
                        android:padding="24dp" android:visibility="gone" />
                    <TextView android:id="@+id/badge" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_margin="12dp"
                        android:background="@drawable/bg_round_8" android:backgroundTint="@color/rose" android:paddingStart="8dp" android:paddingTop="3dp"
                        android:paddingEnd="8dp" android:paddingBottom="3dp" android:text="나만의 스티커"
                        android:textColor="@color/white" android:textSize="10sp" android:visibility="gone" />
                </com.example.dessertrip.ui.collect.common.AspectFrameLayout>

                <TextView android:id="@+id/captionText" style="@style/Dessert.Text.Small" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" />

                <!-- 스티커 완성 후: 이름·카테고리는 필수 -->
                <LinearLayout android:id="@+id/basicsForm" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/Dessert.Text.Label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="디저트 이름 (필수)" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/nameLayout"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/nameInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="디저트 이름을 입력해 주세요." android:inputType="text" android:maxLines="1"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView style="@style/Dessert.Text.Label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="14dp"
                        android:text="카테고리 (필수)" />
                    <AutoCompleteTextView android:id="@+id/categoryField" style="@style/Widget.Dessert.SelectField"
                    android:completionThreshold="1" android:focusableInTouchMode="true" android:imeOptions="actionDone"
                    android:inputType="text" android:maxLines="1"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:layout_marginTop="6dp" android:hint="카테고리를 선택하거나 추가해요" />
                    <TextView android:id="@+id/categoryError" style="@style/Dessert.Text.Small"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textColor="@color/rose" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="12dp"
            android:paddingEnd="20dp" android:paddingBottom="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/primaryButton"
                android:layout_width="match_parent" android:layout_height="52dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/secondaryButton"
                style="@style/Widget.Dessert.Button.Neutral" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="8dp" android:text="다시 고르기" />
            <TextView android:id="@+id/stickerOnlyText" style="@style/Dessert.Text.Small" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                android:gravity="center" android:padding="12dp" android:text="스티커만 저장하기"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/loadingOverlay" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="@color/scrim" android:clickable="true"
        android:focusable="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_margin="32dp" android:background="@drawable/bg_round_20" android:backgroundTint="@color/white"
            android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
            <ProgressBar android:layout_width="36dp" android:layout_height="36dp" android:indeterminateTint="@color/rose" />
            <TextView style="@style/Dessert.Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="이미지의 배경을 제거할게요." />
            <TextView style="@style/Dessert.Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center"
                android:text="디저트만 남겨 스티커로 만들고 있어요.\n잠시만 기다려주세요." />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
