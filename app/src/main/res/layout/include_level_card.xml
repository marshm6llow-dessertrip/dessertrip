<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_round_16" android:backgroundTint="@color/blush"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/levelTitle" style="@style/Dessert.Text.Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/rose" />
            <TextView android:id="@+id/levelSub" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/ink" />
        </LinearLayout>

        <TextView android:id="@+id/collectedText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/rose" android:textSize="32sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/goalText" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:indeterminate="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:indicatorColor="@color/rose"
        app:trackColor="@color/white"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:weightSum="3">
        <TextView android:id="@+id/countCake" style="@style/Dessert.Text.Small" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" />
        <TextView android:id="@+id/countBread" style="@style/Dessert.Text.Small" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="10sp" />
        <TextView android:id="@+id/countBaked" style="@style/Dessert.Text.Small" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
