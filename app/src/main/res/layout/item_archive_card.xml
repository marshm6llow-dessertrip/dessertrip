<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <com.example.dessertrip.ui.collect.common.AspectFrameLayout
        android:id="@+id/stickerFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_16" android:backgroundTint="@color/cream_dark"
        android:clipToOutline="true">
        <TextView android:id="@+id/number" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_margin="10dp" android:textSize="10sp" />
        <ImageView android:id="@+id/sticker" android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="20dp" android:scaleType="fitCenter" android:contentDescription="디저트 스티커" />
    </com.example.dessertrip.ui.collect.common.AspectFrameLayout>

    <TextView android:id="@+id/name" style="@style/Dessert.Text.Body" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end"
        android:maxLines="1" android:textStyle="bold" />
    <TextView android:id="@+id/place" style="@style/Dessert.Text.Small" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" />
</LinearLayout>
