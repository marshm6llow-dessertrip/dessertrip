<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <include android:id="@+id/topBar" layout="@layout/include_top_bar" />

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp">

                <!-- 도감에서 진입한 경우: 대상 디저트 카드 -->
                <LinearLayout android:id="@+id/targetCard" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="@drawable/bg_round_14" android:backgroundTint="@color/white"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp"
                    android:visibility="gone">
                    <ImageView android:id="@+id/targetImage" android:layout_width="48dp" android:layout_height="48dp"
                        android:background="@drawable/bg_round_16" android:backgroundTint="@color/cream_dark" android:contentDescription="디저트 스티커"
                        android:padding="4dp" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:id="@+id/targetNumber" style="@style/Dessert.Text.Caption"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/targetName" style="@style/Dessert.Text.Label"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/dateRow" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView style="@style/Dessert.Text.Small" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="맛본 날" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:src="@drawable/ic_calendar_today" app:tint="@color/ink_sub" />
                    <TextView android:id="@+id/dateText" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="6dp"
                        android:drawableEnd="@drawable/ic_keyboard_arrow_down" android:drawableTint="@color/ink_sub"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView style="@style/Dessert.Text.Title" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="오늘의 한 입은 어땠나요?" />
                    <RatingBar android:id="@+id/starRating"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:numStars="5" android:stepSize="0.5" android:rating="0"
                        android:progressTint="@color/rose" android:progressBackgroundTint="@color/line"
                        android:secondaryProgressTint="@color/line" />
                    <TextView android:id="@+id/ratingLabel" style="@style/Dessert.Text.Caption" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView android:id="@+id/ratingError" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/rose" android:visibility="gone" />
                </LinearLayout>

                <TextView style="@style/FieldLabel" android:text="디저트 이름"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="6dp" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/nameLayout"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/nameInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="디저트 이름을 입력해 주세요." android:inputType="text" android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView style="@style/FieldLabel" android:text="어디에서 드셨나요?"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="6dp" />
                <TextView android:id="@+id/placeField" style="@style/Widget.Dessert.SelectField"
                    android:hint="장소를 검색해 보세요."
    android:layout_width="match_parent"
    android:layout_height="52dp" />

                <TextView style="@style/FieldLabel" android:text="카테고리를 선택해요"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="6dp" />
                <AutoCompleteTextView android:id="@+id/categoryField" style="@style/Widget.Dessert.SelectField"
                    android:completionThreshold="1" android:focusableInTouchMode="true" android:imeOptions="actionDone"
                    android:inputType="text" android:maxLines="1"
                    android:hint="카테고리"
    android:layout_width="match_parent"
    android:layout_height="52dp" />
                <TextView android:id="@+id/categoryError" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/rose"
                    android:visibility="gone" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <TextView style="@style/Dessert.Text.Label" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="어울리는 태그를 검색해요." />
                    <TextView android:id="@+id/tagCount" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="10sp" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    app:startIconDrawable="@drawable/ic_collect_search" app:startIconTint="@color/ink_sub">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/tagSearchInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="태그를 검색하거나 새로 추가해 보세요" android:inputType="text" android:maxLength="20" android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.chip.ChipGroup android:id="@+id/tagGroup" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="0dp" />

                <TextView style="@style/FieldLabel" android:text="나만의 테이스팅 노트"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="6dp" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/noteLayout"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/noteInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="top|start" android:hint="맛, 향, 식감, 분위기를 자유롭게 적어보세요."
                        android:inputType="textMultiLine" android:minLines="5" android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/noteCounter" style="@style/Dessert.Text.Small" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:gravity="end" android:textSize="10sp" />

                <TextView android:id="@+id/photoLabel" style="@style/FieldLabel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="6dp" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout android:id="@+id/photoRow" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/Dessert.Text.Label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="커뮤니티에 공유하기" android:textSize="14sp" />
                        <TextView style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="내가 맛본 디저트를 친구들과 함께 나눠요."
                            android:textSize="10sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/shareSwitch"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:thumbTint="@color/white" app:trackTint="@color/switch_track" app:useMaterialThemeColors="false" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="20dp" android:paddingTop="12dp" android:paddingEnd="20dp" android:paddingBottom="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/saveButton"
                android:layout_width="match_parent" android:layout_height="52dp" android:text="기록 저장하기"
                app:icon="@drawable/ic_check" app:iconGravity="textStart" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
