<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_place"
        app:tint="@color/rose" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:orientation="vertical">
        <TextView android:id="@+id/name" style="@style/Dessert.Text.Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp" />
        <TextView android:id="@+id/address" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="10sp" />
    </LinearLayout>
    <ImageView android:id="@+id/check" android:layout_width="24dp" android:layout_height="24dp"
        android:contentDescription="선택됨" android:src="@drawable/ic_check" app:tint="@color/rose" />
</LinearLayout>
