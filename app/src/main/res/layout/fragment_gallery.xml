<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include android:id="@+id/topBar" layout="@layout/include_top_bar" />

    <TextView style="@style/Dessert.Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="20dp" android:text="선택한 사진만 디저트립과 공유됩니다." />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_round_12" android:backgroundTint="@color/cream_dark"
        app:tabIndicatorColor="@color/rose"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="bottom"
        app:tabSelectedTextColor="@color/rose"
        app:tabTextColor="@color/ink_sub" />

    <TextView android:id="@+id/sectionLabel" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" android:text="최근 항목" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/photoGrid" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/albumList" android:layout_width="match_parent"
            android:layout_height="match_parent" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:visibility="gone" />
        <TextView android:id="@+id/permissionText" style="@style/Dessert.Text.Small" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center" android:text="사진 접근 권한이 필요해요. 탭해서 허용해 주세요."
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/cream_dark" android:gravity="center_vertical" android:orientation="horizontal"
        android:padding="12dp" android:paddingStart="20dp" android:paddingEnd="20dp">
        <ImageView android:id="@+id/selectedThumb" android:layout_width="44dp" android:layout_height="44dp"
            android:background="@color/line" android:contentDescription="선택한 사진" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/selectedTitle" style="@style/Dessert.Text.Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="14sp" />
            <TextView style="@style/Dessert.Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="디저트 스티커로 만들 사진이에요" android:textSize="10sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/addButton" android:layout_width="wrap_content"
            android:layout_height="44dp" android:text="추가" app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
